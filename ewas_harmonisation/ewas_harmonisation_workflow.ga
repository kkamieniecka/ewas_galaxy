            "tool_version": null,
            "label": "Phenotype / batch table",
            "annotation": "Tab-separated table, one row per sample, matching the sample order of the IDAT collections. Must include a batch/cohort column for Stage 3 ComBat correction.",
            "inputs": [
                {"description": "Phenotype/batch table (tabular)", "name": "Phenotype / batch table"}
            ],
            "outputs": [],
