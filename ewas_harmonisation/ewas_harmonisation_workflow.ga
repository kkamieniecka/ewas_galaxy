{
    "a_galaxy_workflow": "true",
    "format-version": "0.1",
    "name": "Cross-array (450K/EPIC) Harmonisation Pipeline",
    "annotation": "Chains the four harmonisation stages (Noob -> betaqn -> ComBat -> common-probe restriction), extending the EWAS-Galaxy suite for cross-platform DNA methylation studies. Each stage's QC/PCA output is exposed as a workflow output so intermediate results can be inspected, matching the original suite's step-by-step design philosophy. NOTE: the final GRSet_common output is NOT yet wired into the existing minfi_analysis (DMR/DMP) tool - that tool currently reads raw IDATs and does its own preprocessing internally. It needs a small parameter branch added (accept a pre-built GRSet and skip internal preprocessing) before it can consume harmonised multi-platform data. See README note at the end of this file's annotation history.",
    "tags": ["epigenetics", "ewas-galaxy", "harmonisation", "450k", "epic"],
    "uuid": "b3f1b0a0-0000-4000-8000-000000000001",
    "steps": {
        "0": {
            "id": 0,
            "type": "data_collection_input",
            "tool_id": null,
            "tool_version": null,
            "label": "Red channel IDAT files (collection)",
            "annotation": "List collection of Red channel .IDAT files, one per sample. Mixed 450K/EPIC samples supported.",
            "inputs": [
                {"description": "Red channel .IDAT files, one per sample", "name": "Red channel IDAT files (collection)"}
            ],
            "outputs": [],
            "input_connections": {},
            "position": {"left": 0, "top": 0},
            "tool_state": "{\"collection_type\": \"list\"}",
